<!-- Views/MountingView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RTXLauncherAUI.ViewModels"
             x:Class="RTXLauncherAUI.Views.MountingView"
             x:DataType="vm:MountingViewModel">
	<Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="10">
		<StackPanel Spacing="5">
			<TextBlock Text="Mounted Remix Games" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
			<CheckBox Content="Half-Life 2: RTX" IsChecked="{Binding MountHl2Rtx}"/>
			<CheckBox Content="Portal with RTX" IsChecked="{Binding MountPortalRtx}"/>
			<CheckBox Content="Portal: Prelude RTX" IsChecked="{Binding MountPortalPreludeRtx}"/>
			<CheckBox Content="Portal 2 with RTX" IsChecked="{Binding MountPortal2Rtx}"/>
			<CheckBox Content="Dark Messiah RTX" IsChecked="{Binding MountDarkMessiahRtx}"/>
		</StackPanel>
	</Border>
</UserControl>
