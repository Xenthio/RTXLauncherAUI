<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTXLauncherAUI.ViewModels"
        xmlns:views="using:RTXLauncherAUI.Views"
        x:Class="RTXLauncherAUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RTXLauncherAUI" Width="800" Height="550">

	<Grid RowDefinitions="*,Auto" Margin="10">

		<!-- Main Content Area with Sidebar -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*">

			<!-- Sidebar Navigation -->
			<ListBox Grid.Column="0"
					ItemsSource="{Binding Pages}"
					SelectedItem="{Binding SelectedPage}"
					Width="150" Margin="0,0,10,0">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<!-- The TextBlock binds to the "Header" property we created -->
						<TextBlock Text="{Binding Header}" Margin="5"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Content Display Area -->
			<Border Grid.Column="1"
				BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
				<!-- This ContentControl's content is bound to the SelectedPage -->
				<!-- The DataTemplates above will determine what to display here -->
				<ContentControl Content="{Binding SelectedPage}"/>
			</Border>

		</Grid>

		<!-- Bottom Buttons (This stays the same) -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
			<Button Content="Open Install Folder"/>
			<Button Content="Launch Game"/>
			<Button Content="Close"/>
		</StackPanel>

	</Grid>
</Window>
